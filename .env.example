# Copy to .env.local for development, and set the same variables in Vercel.
# Everything here is optional: with no value the feature is skipped and the page still works.

# Server-only. n8n webhook that receives lead-form submissions.
# Missing: the lead is logged to the server console and the visitor still sees the
# confirmation message. Never expose this URL to the browser.
N8N_LEAD_WEBHOOK_URL=

# Public. Meta Pixel ID. Missing: the pixel is not loaded and tracking calls are no-ops.
NEXT_PUBLIC_META_PIXEL_ID=

# Public. GA4 measurement ID, e.g. G-XXXXXXXXXX.
# Missing: gtag is not loaded and tracking calls are no-ops.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Server-only. Live lot status from the admin database (project mazaltepec-admin), the same
# one the admin app writes and precios.mazaltepec.com reads. Only `code` and `status` are
# ever requested — never price. Missing or unreachable: the plan falls back to the statuses
# in data/lots.ts and logs why; the page still works.
# Deliberately NOT prefixed NEXT_PUBLIC_: nothing here is sent to the browser.
SUPABASE_URL=https://ameoullltomkvomsbbmc.supabase.co
# The public key. Either works; the publishable one wins if both are set:
#  - SUPABASE_ANON_KEY — set automatically by the Vercel ↔ Supabase integration (legacy JWT).
#  - SUPABASE_PUBLISHABLE_KEY — sb_publishable_…, Supabase → Project Settings → API Keys.
# Both are public by design, but keep them out of this file — the repository is public.
# Never use the service role key here; the page does not read it.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
